# ═══════════════════════════════════════════════════════════════
# GigaWork Frontend — Environment Variables
# Copy this file to .env.local and fill in your values
# All NEXT_PUBLIC_* vars are exposed to the browser (safe to share)
# ═══════════════════════════════════════════════════════════════

# ─── Backend API ─────────────────────────────────────────────
# Local dev: http://localhost:8181/api
# Production: https://your-backend.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:8181/api

# ─── Privy Auth ──────────────────────────────────────────────
# Get from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ─── Smart Contracts (Arc Testnet — Chain 5042002) ───────────
NEXT_PUBLIC_COMMERCE_ADDRESS=0xefe28B2FB1146A5d95c7E5e134cEF7a180D47e34
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_STAKING_ADDRESS=0x5aC6d607B33C02268a86E0D28Ee9Cbe086AE214f

# ─── RPC ─────────────────────────────────────────────────────
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network
