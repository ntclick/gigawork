# ═══════════════════════════════════════════════════════════════
# GigaWork Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Arc Network (Testnet — Chain 5042002) ────────────────────
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
ARC_WS_URL=wss://rpc.drpc.testnet.arc.network

# Server wallet private key (signs all on-chain txs)
# NEVER commit this to git. Fund with ARC gas + USDC.
PRIVATE_KEY=0x...

# Treasury address (receives platform fees)
TREASURY_ADDRESS=0xafe6DD950Dc2CF561e8daBA1725e0e6840f70549

# ─── Smart Contracts ──────────────────────────────────────────
GIGAWORK_ESCROW_ADDRESS=0x92FA695562B6877BeE09EE826821Fbe8Ae6faf46
GIGAWORK_REGISTRY_ADDRESS=0x26BAB1CD090c1a44C189dCfd9D32d3AC80bfD0d1
# ERC-8004 Identity Registry (auto-registers agents on startup)
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# ─── Supabase (PostgreSQL via PostgREST) ─────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─── Privy Auth (server-side) ────────────────────────────────
# Get from https://dashboard.privy.io
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# ─── AI / External APIs ─────────────────────────────────────
# DeepSeek (LLM for all agents) — https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Birdeye (crypto data) — https://birdeye.so
BIRDEYE_API_KEY=

# Apify (web scraping) — https://apify.com
APIFY_API_TOKEN=

# ─── Server Config ───────────────────────────────────────────
PORT=8181

# CORS allowed origins (comma-separated)
# Production: add your frontend domain
ALLOWED_ORIGINS=http://localhost:3001,https://gigawork.vercel.app

# ─── Optional / Auto-generated ───────────────────────────────
# Auth session HMAC secret (auto-generated if empty)
AUTH_SECRET=

# Webhook HMAC signing secret (auto-generated if empty)
WEBHOOK_SECRET=

# Telegram bot for notifications (optional)
TELEGRAM_BOT_TOKEN=
