# Arc Network (Testnet — Chain 5042002)
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
ARC_WS_URL=wss://rpc.drpc.testnet.arc.network
GIGAWORK_REGISTRY_ADDRESS=0x26BAB1CD090c1a44C189dCfd9D32d3AC80bfD0d1
GIGAWORK_ESCROW_ADDRESS=0x92FA695562B6877BeE09EE826821Fbe8Ae6faf46
PRIVATE_KEY=0x...
# ^ Also used to auto-register seeded agents on ERC-8004 Identity Registry.
#   Needs ARC gas (~0.006 USDC per agent, 5 agents = ~0.03 USDC total).
#   Registration happens once on first startup, then tokens persist in DB.

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=...

# Telegram
TELEGRAM_BOT_TOKEN=...

# Platform
PORT=8080
TREASURY_ADDRESS=0xafe6DD950Dc2CF561e8daBA1725e0e6840f70549

# Birdeye API (crypto data — get from https://birdeye.so)
BIRDEYE_API_KEY=

# Webhook HMAC signing (32-byte hex, auto-generated if empty)
WEBHOOK_SECRET=

# CORS allowed origins (comma-separated, defaults to localhost if empty)
ALLOWED_ORIGINS=http://localhost:8181,http://localhost:8080
