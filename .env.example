# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Connection string with DB password (Settings → Database → URI mode)
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Kimi / Moonshot (OpenAI-compatible)
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Skill provider APIs (optional — agents fall back to mock if missing) ───
# OpenSea v2 API: NFT floor + volume + owners. Free without key (rate-limited),
# full quota with OPENSEA_API_KEY. https://docs.opensea.io
OPENSEA_API_KEY=

# Reservoir was removed — DNS-blocked in some regions. OpenSea is primary now.
RESERVOIR_API_KEY=

# Alchemy: wallet activity (whale-tracker). Free 300M req/mo. https://alchemy.com
ALCHEMY_API_KEY=

# CoinGecko Pro (crypto-scanner price/marketcap fallback). Free pro 10k req/mo.
COINGECKO_API_KEY=

# TAAPI: paid alt for trading-signals (we use Binance public by default).
TAAPI_KEY=

# Birdeye: Solana token data (crypto-scanner). Paid $99/mo.
BIRDEYE_API_KEY=

# Apify: web scraping (web-intel + social-sentiment Twitter). Paid $49/mo.
APIFY_API_TOKEN=

# ─── On-chain (USDC pill in MainHeader reads from these) ───
NEXT_PUBLIC_ARC_RPC=https://rpc.drpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_USDC_DECIMALS=6
NEXT_PUBLIC_ARC_EXPLORER=https://testnet.arcscan.app

# ─── ERC-8183 real on-chain lifecycle (opt-in) ───
# When set to "1", every new workflow opens an ERC-8183 job on the
# AgenticCommerce contract: createJob → setBudget → approve USDC →
# fund → (after finalizeReport) submit + complete. Requires
# ADMIN_PRIVATE_KEY to hold testnet USDC + ETH for gas.
ERC8183_ENABLED=0
AGENTIC_COMMERCE_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
ERC8183_BUDGET_USDC=0.05
ADMIN_PRIVATE_KEY=
