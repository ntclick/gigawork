# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Connection string. On Vercel/serverless, USE THE POOLER (port 6543) — direct
# (port 5432) connections exhaust quickly and cause /api/* 503 storms. Get it
# from Supabase: Settings → Database → "Connection pooling" → Transaction.
# Looks like:
#   postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── Brain provider ──────────────────────────────────────────
# Default: OpenAI gpt-5-mini. Switch to kimi or deepseek by setting
# AI_PROVIDER. Each provider keeps its own keys + model so you can
# swap without losing config.
AI_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Auto-fallback when the primary model returns 404 model_not_found / 403
# (e.g. API key tier without GPT-4o-mini access). One-shot probe at first
# streamBrain call. Default = gpt-4o.
OPENAI_FALLBACK_MODEL=gpt-4o

# Kimi / Moonshot (alternative)
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

# DeepSeek (alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=cmnl...
NEXT_PUBLIC_PRIVY_CLIENT_ID=client-...

# ─── Skill provider APIs (optional — agents fall back to mock if missing) ───
# OpenSea v2 API: NFT floor + volume + owners. Free without key (rate-limited),
# full quota with OPENSEA_API_KEY. https://docs.opensea.io
OPENSEA_API_KEY=

# Reservoir was removed — DNS-blocked in some regions. OpenSea is primary now.
RESERVOIR_API_KEY=

# Alchemy: wallet activity (whale-tracker). Free 300M req/mo. https://alchemy.com
ALCHEMY_API_KEY=
BLOCKSCOUT_API_KEY=

# CoinGecko Pro (crypto-scanner price/marketcap fallback). Free pro 10k req/mo.
COINGECKO_API_KEY=

# TAAPI: paid alt for trading-signals (we use Binance public by default).
TAAPI_KEY=

# Birdeye: Solana token data (crypto-scanner). Paid $99/mo.
BIRDEYE_API_KEY=

# Apify: web scraping (web-intel + social-sentiment Twitter). Paid $49/mo.
APIFY_API_TOKEN=

# Pinata IPFS (Metadata upload for ERC-8004 agents)
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── On-chain (USDC pill in MainHeader reads from these) ───
ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER=https://testnet.arcscan.app
ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_USDC_DECIMALS=6

# ─── Credits Top-Up and Treasury ───
USDC_TREASURY_ADDRESS=0xafe6dd950dc2cf561e8daba1725e0e6840f70549
NEXT_PUBLIC_USDC_TREASURY=0xafe6dd950dc2cf561e8daba1725e0e6840f70549
TOPUP_RATE_CREDITS_PER_USDC=100

# ─── Circle App-Kit (swap / bridge / routing) ───
# Get a free kit key from https://console.circle.com
CIRCLE_KIT_KEY=KIT_KEY_xxx

# ─── ERC-8183 real on-chain lifecycle (opt-in) ───
# When set to "1", every new workflow opens an ERC-8183 job on the
# AgenticCommerce contract: createJob → setBudget → approve USDC →
# fund → (after finalizeReport) submit + complete. Requires
# ADMIN_PRIVATE_KEY to hold testnet USDC + ETH for gas.
ERC8183_ENABLED=0
AGENTIC_COMMERCE_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
ERC8183_BUDGET_USDC=0.05
ADMIN_PRIVATE_KEY=

# ─── Plan A: user-as-client + admin-as-provider+evaluator ──────
# When ERC8183_USER_CLIENT=1, openAndFundJob switches to a 2-step flow:
#   1. backend prepares calldata for user's Privy wallet to sign
#      (createJob → approve → fund)
#   2. admin server-side signs setBudget (between createJob and fund)
#      and submit + complete (after the brain's finalizeReport)
# Independent from ERC8183_ENABLED — both must be on for real escrow.
# Leave at 0 until the v3 user-mint UI is ready end-to-end.
ERC8183_USER_CLIENT=0

# ─── ERC-8004 Reputation Registry (deployed via pnpm reputation:deploy) ───
REPUTATION_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_IDENTITY_REGISTRY=
VALIDATION_REGISTRY_ADDRESS=

# ─── Post-mint side effects ────────────────────────────────────
# When PREFUND_AFTER_MINT=1, /api/identity/confirm transfers starter native
# gas + ERC-20 USDC from the admin wallet to the user wallet right after a
# successful ERC-8004 mint. One-shot, idempotent via users.prefunded_at.
# Use the 300-credit bonus + this pre-fund together = the "free trial"
# package that lets a fresh user run ~6 ERC-8183 workflows without paying.
PREFUND_AFTER_MINT=0
PREFUND_NATIVE_AMOUNT=0.01
PREFUND_USDC_AMOUNT=0.3

# ─── Server Administration & Webhooks ───
ADMIN_MIGRATE_TOKEN=some_secure_token_for_migration
HERMES_WEBHOOK_SECRET=some_hermes_webhook_secret_here

